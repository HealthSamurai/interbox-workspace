# Copy to .env and fill in. docker compose reads this file automatically.
# .env is gitignored — never commit real secrets.

# ── License (pick ONE path) ──────────────────────────────────────────────────
# The image is licensed: the pipeline is PAUSED until a valid interbox license is
# present. Either:
#   (a) paste an interbox license JWT here (from the Aidbox portal), or
#   (b) leave blank and click through the dashboard's activation screen at
#       http://localhost:3001 (portal OAuth) — the engine picks it up live.
INTERBOX_LICENSE=

# ── Aidbox (pipeline sender target) ──────────────────────────────────────────
# Leave blank to boot Aidbox unlicensed and activate it from the dashboard (Sign
# in with your Health Samurai account) — the compose entrypoint strips a blank
# value so Aidbox starts in activation mode instead of crashing. Or paste a free
# dev license JWT from the Aidbox portal here to skip the in-dashboard step.
AIDBOX_LICENSE=
# The Aidbox Client interbox authenticates as. CLIENT_ID is optional — the sender
# defaults to `root`; set a scoped client for least privilege. SECRET must match the
# Client's secret in Aidbox (BOX_ROOT_CLIENT_SECRET for the default root client).
# AIDBOX_CLIENT_ID=root
AIDBOX_CLIENT_SECRET=secret

# ── Dashboard assistant (Claude Code over ACP) ───────────────────────────────
# Optional — with none of the three below set the dashboard still works, the
# assistant just can't answer.
#
# DEFAULT (dev, Linux/Windows hosts): reuse the host's own Claude Code login. The
# dir below is bind-mounted into the container at the image's HOME, so the agent
# runs on your existing session — no token to mint, no docker-compose edit.
# It mounts the WHOLE dir, so the container also sees your Claude settings, your
# session transcripts under projects/, and any MCP OAuth tokens the login file
# carries. Comment this out to expose nothing (the mount falls back to an empty
# managed volume) and authenticate with one of the alternatives instead.
# macOS keeps its creds in the Keychain rather than a dir, so this cannot work
# there — run ./scripts/setup-claude-mac.sh to mint a token instead.
# ${HOME} covers POSIX shells and PowerShell, ${USERPROFILE} covers cmd.exe.
CLAUDE_CONFIG_DIR=${HOME:-${USERPROFILE}}/.claude
#
# Alternative 1 — a subscription token, and the only path that works on every host
# OS (macOS included). On a host with Claude Code + a Pro/Max subscription run
#   claude setup-token
# and paste it below — it bills the SUBSCRIPTION, not per-token API usage.
CLAUDE_CODE_OAUTH_TOKEN=
# Alternative 2 — pay-per-token API billing instead of the subscription.
# ANTHROPIC_API_KEY=sk-ant-...
# Either alternative OUTRANKS the mounted login above, so a leftover token here
# silently wins over the host session — blank both to fall back to the mount.

# ── Image version ────────────────────────────────────────────────────────────
# Interbox engine version (image tag), pinned to a released version for a
# reproducible, matched engine+SDK pair. Use `edge` for the latest main build
# instead. To update the engine: change this, then
#   docker compose pull interbox && docker compose up -d interbox
# In the dev image the SDK ships inside the image, so this tag pins engine + SDK
# together — keep your package.json @health-samurai/interbox pin in the same range.
INTERBOX_VERSION=1.13.0
# Optional: point at a mirror/private registry (default Docker Hub, healthsamurai
# org — no host prefix needed, same as healthsamurai/aidboxone above).
# INTERBOX_REGISTRY=healthsamurai
# If pulling a private mirror: `docker login` with that registry's own
# credentials first.
